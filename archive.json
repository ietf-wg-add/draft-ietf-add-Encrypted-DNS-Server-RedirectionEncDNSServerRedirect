      "reviews": [
        {
          "id": "PRR_kwDOMRm-Tc6OCW_a",
          "commit": {
            "abbreviatedOid": "9631b99"
          },
          "author": "cmosher",
          "authorAssociation": "NONE",
          "state": "APPROVED",
          "body": "This goes back to one of our earlier discussions about the implementation considerations. While out of scope of the draft, as you noted previously, I do agree that some guidance or a reference implementation is desirable here.\r\n\r\nA capabilities-aware cache / management implementation is an obvious solution to extend EDSR without requiring restrictive or specific standards guidance, and a good place to hang server or implementation recommendations that can address these points without bloating the text.",
          "createdAt": "2024-10-21T18:12:59Z",
          "updatedAt": "2024-10-21T18:12:59Z",
          "comments": []
        },
