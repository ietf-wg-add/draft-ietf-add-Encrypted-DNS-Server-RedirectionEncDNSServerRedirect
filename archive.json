        {
          "author": "mstojens",
          "authorAssociation": "COLLABORATOR",
          "body": "What do you think of the latest, @cmosher ? I added a bit more hoping to capture your intent.",
          "createdAt": "2024-10-21T18:29:07Z",
          "updatedAt": "2024-10-21T18:29:07Z"
